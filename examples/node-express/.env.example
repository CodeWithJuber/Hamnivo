# Settings for the Express example. Copy to .env (never commit it) and fill in.

# The brand's widget ID (wid_...).
HAMNIVO_WIDGET_ID=

# The key id you registered for the brand, and one of:
# - HAMNIVO_IDENTITY_KEY: the private JWK of an ES256, EdDSA or RS256 key, as JSON in single quotes
#   (`pnpm --filter @hamnivo/example-node-express keygen` makes one);
# - HAMNIVO_IDENTITY_SECRET: the HS256 secret Hamnivo showed once.
HAMNIVO_IDENTITY_KID=
HAMNIVO_IDENTITY_KEY=
HAMNIVO_IDENTITY_SECRET=

# Where Hamnivo Chat (loader.js) and the Hamnivo API are served. These are the local defaults.
HAMNIVO_WIDGET_ORIGIN=http://localhost:5174
HAMNIVO_API=http://localhost:4000

# This website. Its origin must be one of the brand's allowed websites.
PORT=8080
