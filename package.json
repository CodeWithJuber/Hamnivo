{
  "name": "hamnivo",
  "private": true,
  "description": "Hamnivo — conversations, people and agents in one place.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:integrations": "bash scripts/build-integrations.sh",
    "dev": "turbo run dev --parallel",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "ci:local": "bash scripts/ci/local.sh",
    "services:up": "bash scripts/dev/up.sh",
    "services:down": "bash scripts/dev/down.sh",
    "db:migrate": "pnpm --filter @hamnivo/db db:migrate",
    "api": "pnpm --filter @hamnivo/gateway build && pnpm --filter @hamnivo/gateway start:api",
    "worker": "pnpm --filter @hamnivo/gateway build && pnpm --filter @hamnivo/gateway start:worker",
    "chatwoot:up": "bash scripts/chatwoot/up.sh",
    "chatwoot:down": "bash scripts/chatwoot/down.sh",
    "knip": "knip",
    "changeset": "changeset",
    "status": "tsx scripts/feature-status/generate.ts",
    "licenses": "tsx scripts/licenses/inventory.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.0",
    "knip": "6.48.0",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
