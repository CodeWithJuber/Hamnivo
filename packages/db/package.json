{
  "name": "@hamnivo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Hamnivo database: Drizzle schema, SQL migrations with row-level security, tenant-scoped transactions and hash-chained audit",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "platform:operator": "tsx scripts/platform-operator.ts",
    "auth:schema": "auth generate --config scripts/better-auth.schema.config.ts --output /tmp/hamnivo-auth-schema.ts --yes"
  },
  "dependencies": {
    "@hamnivo/contracts": "workspace:*",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "typeid-js": "1.2.0",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
