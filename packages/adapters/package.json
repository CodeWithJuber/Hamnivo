{
  "name": "@hamnivo/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Hamnivo provider adapters behind shared contracts: language and embedding models for Anthropic, OpenAI, Google Gemini and OpenAI-compatible servers, with capability tables, error normalization, fallback and deterministic mocks; later Jev, commerce, scanner, storage and network adapters",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/google": "4.0.82",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@ai-sdk/provider": "4.0.18",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ai": "7.0.116",
    "msw": "2.15.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
