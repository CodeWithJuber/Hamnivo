{
  "name": "@hamnivo/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Hamnivo provider adapters behind shared contracts: language and embedding models for Anthropic, OpenAI, Google Gemini and OpenAI-compatible servers (capability tables, error normalization, fallback, deterministic mocks), the Jev decision provider, commerce providers (Stripe hosted checkout and refunds, an in-memory mock), SSRF-safe outbound requests under an egress policy (net), the port for collecting platform invoice payments (billing), the MCP adapter for remote tools (Streamable HTTP through its own SSRF-safe egress guard) and an in-memory demo order service for the built-in demo tools; scanner and storage adapters follow",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./jev": {
      "types": "./dist/jev/index.d.ts",
      "import": "./dist/jev/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./commerce/testing": {
      "types": "./dist/commerce/testing.d.ts",
      "import": "./dist/commerce/testing.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "import": "./dist/net/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./mcp/testing": {
      "types": "./dist/mcp/testing.d.ts",
      "import": "./dist/mcp/testing.js"
    },
    "./egress": {
      "types": "./dist/egress/index.d.ts",
      "import": "./dist/egress/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/google": "4.0.82",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@ai-sdk/provider": "4.0.18",
    "@hamnivo/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@typesafe-ai/sdk": "0.6.0",
    "stripe": "22.6.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ai": "7.0.116",
    "msw": "2.15.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
