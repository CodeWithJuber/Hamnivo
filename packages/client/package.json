{
  "name": "@hamnivo/client",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Hamnivo chat SDK for browsers and Node: widget sessions with token refresh, a send outbox with exactly-once retries, and resumable event streams",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hamnivo/contracts": "workspace:*",
    "eventsource-parser": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "msw": "2.15.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
