{
  "name": "@hamnivo/react",
  "version": "0.1.0",
  "description": "Hamnivo Chat for React and Next.js: a component that puts the chat on your site, a hook for the chat window, and hooks for building your own chat on @hamnivo/client",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "hamnivo",
    "chat",
    "customer-support",
    "react",
    "nextjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsdown && vitest run"
  },
  "peerDependencies": {
    "@hamnivo/client": ">=0.1.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@hamnivo/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hamnivo/client": "workspace:*",
    "@hamnivo/server": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
