{
  "name": "@hamnivo/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Hamnivo domain types and ports: the conversation authority and decision ports, pure domain rules such as explicit human-request detection, and commerce rules (money, state machines, quote hashing, approvals, refund policy, capabilities, receipt-backed claims) and AI action rules (portable tool schemas, action policy, approval binding, autopilot decisions, receipt-backed action claims, handoff packets, simulation comparison)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.js"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@noble/hashes": "2.4.0",
    "canonicalize": "5.1.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0"
  }
}
