{
  "name": "@hamnivo/contracts",
  "version": "0.1.0",
  "description": "Hamnivo public contracts: message parts, cards, event envelope, errors and API schemas (Zod 4 → OpenAPI 3.1)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi/hamnivo.v1.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsdown",
    "openapi": "tsx scripts/openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/openapi.ts --check && vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod-openapi": "6.0.2"
  }
}
