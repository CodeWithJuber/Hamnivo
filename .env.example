# Hamnivo local development defaults (scripts/dev/up.sh creates these roles and databases).
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# PostgreSQL: the app role cannot bypass row-level security; the owner role runs migrations.
DATABASE_URL=postgres://hamnivo_app:hamnivo_app_dev@127.0.0.1:5432/hamnivo
DATABASE_OWNER_URL=postgres://hamnivo_owner:hamnivo_owner_dev@127.0.0.1:5432/hamnivo
DATABASE_PLATFORM_URL=postgres://hamnivo_platform:hamnivo_platform_dev@127.0.0.1:5432/hamnivo

REDIS_URL=redis://127.0.0.1:6379

# 32-byte base64 key-encryption key for stored secrets (generate: openssl rand -base64 32)
HAMNIVO_KEK_BASE64=
# Better Auth
BETTER_AUTH_SECRET=
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_CONSOLE_ORIGIN=http://localhost:5173
PUBLIC_WIDGET_ORIGIN=http://localhost:5174

# Chatwoot (conversation authority). Platform token comes from Super Admin → Platform Apps.
CHATWOOT_URL=http://127.0.0.1:3000
CHATWOOT_PLATFORM_TOKEN=

# Model providers (optional; the deterministic mock provider is used when unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Jev / TypeSafe decision provider (optional; shadow mode by default)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=

# Commerce (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHMCS_URL=
WHMCS_IDENTIFIER=
WHMCS_SECRET=

# Voice/video (optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
