# Reference of every setting Hamnivo reads. Do not copy real values here.
# Run `bash scripts/setup/env.sh` to create .env.local with generated passwords and secrets.

NODE_ENV=development

# PostgreSQL: the app role cannot bypass row-level security; the owner role runs migrations.
DATABASE_URL=postgres://hamnivo_app:<generated>@127.0.0.1:5432/hamnivo
DATABASE_OWNER_URL=postgres://hamnivo_owner:<generated>@127.0.0.1:5432/hamnivo
DATABASE_PLATFORM_URL=postgres://hamnivo_platform:<generated>@127.0.0.1:5432/hamnivo

REDIS_URL=redis://127.0.0.1:6379

# 32-byte base64 key-encryption key for stored secrets (generated by scripts/setup/env.sh).
# To rotate: set a new key and version, and list old keys as version:base64 in HAMNIVO_KEK_RETIRED
# until every secret has been read once (they are rewrapped on use).
HAMNIVO_KEK_BASE64=
HAMNIVO_KEK_VERSION=1
HAMNIVO_KEK_RETIRED=
# Gateway (apps/gateway)
PORT=4000
LOG_LEVEL=info
# Staff sign-in (Better Auth): session signing secret, email verification, step-up freshness
BETTER_AUTH_SECRET=
REQUIRE_EMAIL_VERIFICATION=true
STEP_UP_MAX_AGE_MINUTES=10
# Outgoing email; without SMTP_URL messages (verification links, invitations) are written to the log
SMTP_URL=
MAIL_FROM=Hamnivo <no-reply@example.com>
# The worker rewrites this file after every outbox pass (container health checks); off when empty
WORKER_HEARTBEAT_FILE=
# GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>"; disabled when empty
METRICS_TOKEN=
API_DOCS=true
RATE_LIMIT_PER_MINUTE=600
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_CONSOLE_ORIGIN=http://localhost:5173
PUBLIC_WIDGET_ORIGIN=http://localhost:5174
# ES256 private key for widget access tokens (PKCS#8 PEM, base64). scripts/setup/env.sh makes one.
WIDGET_SIGNING_KEY=

# Chatwoot (conversation authority). `pnpm chatwoot:up` generates these and adds the Platform App
# token; for an existing Chatwoot, create a Platform App under Super Admin → Platform Apps.
CHATWOOT_PORT=3000
CHATWOOT_URL=http://127.0.0.1:3000
CHATWOOT_PLATFORM_TOKEN=
# Base URL Chatwoot uses for webhooks to the gateway (public HTTPS URL in production).
CHATWOOT_WEBHOOK_BASE_URL=http://host.docker.internal:4000
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_DB_PASSWORD=
CHATWOOT_ADMIN_EMAIL=admin@hamnivo.local
CHATWOOT_ADMIN_PASSWORD=
# Development only: lets Chatwoot deliver webhooks to this machine. Keep false in production.
CHATWOOT_ALLOW_PRIVATE_WEBHOOKS=true

# Model providers (optional; the deterministic mock provider is used when unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Knowledge: embedding model for search (mock is offline and word-based) and ClamAV for uploads
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hamnivo-embed
CLAMAV_URL=

# Jev / TypeSafe decision provider (optional; shadow mode by default). Each rubric pins its model
# version in Studio, such as jev-1.13.0. TYPESAFE_BASE_URL is only for another endpoint.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# Commerce. Each brand's Stripe keys are entered through the admin API and kept only in the secret
# broker, never here. Provider request timeout (a write that times out is checked, never resent
# blindly), how long a payment page stays open (30 to 1440 minutes), and in-memory `mock` merchants
# outside development (demos only).
COMMERCE_PROVIDER_TIMEOUT_MS=10000
COMMERCE_CHECKOUT_MINUTES=60
COMMERCE_ALLOW_MOCK=false

# Voice/video (optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
