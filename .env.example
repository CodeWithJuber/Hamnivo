# Reference of every setting Hamnivo reads. Do not copy real values here.
# Run `bash scripts/setup/env.sh` to create .env.local with generated passwords and secrets.

NODE_ENV=development

# PostgreSQL: the app role cannot bypass row-level security; the owner role runs migrations.
DATABASE_URL=postgres://hamnivo_app:<generated>@127.0.0.1:5432/hamnivo
DATABASE_OWNER_URL=postgres://hamnivo_owner:<generated>@127.0.0.1:5432/hamnivo
DATABASE_PLATFORM_URL=postgres://hamnivo_platform:<generated>@127.0.0.1:5432/hamnivo

REDIS_URL=redis://127.0.0.1:6379

# 32-byte base64 key-encryption key for stored secrets (generated by scripts/setup/env.sh).
# To rotate: set a new key and version, and list old keys as version:base64 in HAMNIVO_KEK_RETIRED
# until every secret has been read once (they are rewrapped on use).
HAMNIVO_KEK_BASE64=
HAMNIVO_KEK_VERSION=1
HAMNIVO_KEK_RETIRED=
# Gateway (apps/gateway)
PORT=4000
LOG_LEVEL=info
# Staff sign-in (Better Auth): session signing secret, email verification, step-up freshness
BETTER_AUTH_SECRET=
REQUIRE_EMAIL_VERIFICATION=true
STEP_UP_MAX_AGE_MINUTES=10
# Single sign-on (each workspace connects its own provider in Studio, under Security). Providers must
# use HTTPS on a public address unless their origin is listed here (comma-separated). DNS servers for
# domain checks, as ip or ip:port (comma-separated); empty uses the system resolver.
SSO_TRUSTED_IDP_ORIGINS=
SSO_DNS_SERVERS=
# Outgoing email; without SMTP_URL messages (verification links, invitations) are written to the log
SMTP_URL=
MAIL_FROM=Hamnivo <no-reply@example.com>
# The worker rewrites this file after every outbox pass (container health checks); off when empty
WORKER_HEARTBEAT_FILE=
# Background jobs the worker runs at the same time; each conversation's jobs stay in order.
# 1 runs them one by one. Keep it under DATABASE_POOL_MAX.
OUTBOX_CONCURRENCY=4
# GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>"; disabled when empty
METRICS_TOKEN=
API_DOCS=true
RATE_LIMIT_PER_MINUTE=600
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_CONSOLE_ORIGIN=http://localhost:5173
PUBLIC_WIDGET_ORIGIN=http://localhost:5174
# ES256 private key for widget access tokens (PKCS#8 PEM, base64). scripts/setup/env.sh makes one.
WIDGET_SIGNING_KEY=

# Chatwoot (conversation authority). `pnpm chatwoot:up` generates these and adds the Platform App
# token; for an existing Chatwoot, create a Platform App under Super Admin → Platform Apps.
CHATWOOT_PORT=3000
CHATWOOT_URL=http://127.0.0.1:3000
CHATWOOT_PLATFORM_TOKEN=
# Base URL Chatwoot uses for webhooks to the gateway (public HTTPS URL in production).
CHATWOOT_WEBHOOK_BASE_URL=http://host.docker.internal:4000
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_DB_PASSWORD=
CHATWOOT_ADMIN_EMAIL=admin@hamnivo.local
CHATWOOT_ADMIN_PASSWORD=
# Development only: lets Chatwoot deliver webhooks to this machine. Keep false in production.
CHATWOOT_ALLOW_PRIVATE_WEBHOOKS=true

# Model providers (optional; the deterministic mock provider is used when unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# AI replies to customers are streamed while written: whole sentences that pass the checks show
# as a draft, and what the assistant is doing is said. false: the reply arrives whole.
AI_STREAM_REPLIES=true
# After each AI answer, up to three questions the customer might ask next (brands can turn them
# off in their chat settings). They cost a few tokens per answer. false: never.
AI_FOLLOW_UPS=true

# Knowledge: embedding model for search (mock is offline and word-based) and ClamAV for uploads
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hamnivo-embed
CLAMAV_URL=
# Websites kept as knowledge are read one request at a time, at least this many milliseconds apart.
KNOWLEDGE_WEB_DELAY_MS=1000

# Jev / TypeSafe decision provider (optional; shadow mode by default). Each rubric pins its model
# version in Studio, such as jev-1.13.0. TYPESAFE_BASE_URL is only for another endpoint.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=

# Commerce. Each brand's Stripe keys are entered through the admin API and kept only in the secret
# broker, never here. Provider request timeout (a write that times out is checked, never resent
# blindly), how long a payment page stays open (30 to 1440 minutes), and in-memory `mock` merchants
# outside development (demos only).
COMMERCE_PROVIDER_TIMEOUT_MS=10000
COMMERCE_CHECKOUT_MINUTES=60
COMMERCE_ALLOW_MOCK=false

# Imports from other tools (Studio, Imports). Messages per minute written into one Chatwoot
# conversation (Chatwoot allows 200), how long a worker pass and how many conversations it takes,
# days an uploaded export is kept after its job ends, conversations one import reads from another
# Chatwoot, and whether that Chatwoot may be at a private address (local development only).
MIGRATION_MESSAGES_PER_MINUTE=180
MIGRATION_SLICE_SECONDS=20
MIGRATION_SLICE_CONVERSATIONS=200
MIGRATION_EXPORT_RETENTION_DAYS=14
MIGRATION_SOURCE_MAX_CONVERSATIONS=1000
MIGRATION_SOURCE_ALLOW_PRIVATE=false

# Developer platform (docs/guides/api-keys.md, docs/guides/webhooks.md): requests per minute for
# each API key; webhook delivery: attempt deadline, days events (for replays) and the delivery log
# are kept, when a failing endpoint is turned off, sends at the same time per worker. Origins in
# EGRESS_TRUSTED_ORIGINS (comma-separated) may be called over plain HTTP and on private addresses
# (by webhooks, and by a model server a workspace names in its model connections): leave it empty
# in production unless a trusted internal service needs it.
API_KEY_RATE_LIMIT_PER_MINUTE=120
# Tool calls per minute for one API key on the MCP server (/mcp), on top of the budget above.
MCP_RATE_LIMIT_PER_MINUTE=30
WEBHOOK_TIMEOUT_MS=15000
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_LOG_DAYS=90
WEBHOOK_DISABLE_AFTER_FAILURES=10
WEBHOOK_DISABLE_AFTER_HOURS=72
WEBHOOK_CONCURRENCY=8
# Retention (A10): old resolved conversations the worker deletes per run (every 10 minutes),
# across workspaces, and at most per workspace. Retention itself is off until an owner sets it.
RETENTION_BATCH=100
RETENTION_PER_WORKSPACE=25
EGRESS_TRUSTED_ORIGINS=

# Reports withhold any number that stands on fewer conversations or responses than this (2 to 50).
ANALYTICS_MIN_GROUP_SIZE=5
# Plans and invoices are run by Hamnivo's operator with `pnpm --filter @hamnivo/gateway billing`
# (needs DATABASE_PLATFORM_URL): days from issuing an invoice to its due date, and the operator's
# name for the audit log.
BILLING_INVOICE_DUE_DAYS=14
HAMNIVO_OPERATOR=

# Running Hamnivo as a service for many businesses (docs/guide/saas/). Public sign-up on or off
# (the platform console can change it); new workspaces start on this plan ("unlimited": no plan,
# nothing limited, the usual choice when you host Hamnivo only for yourself).
HAMNIVO_PUBLIC_SIGNUP=true
HAMNIVO_DEFAULT_PLAN=free
# Cloudflare Turnstile on sign-up: set both keys, or neither (off).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Who bills workspaces: free (nobody), stripe or whmcs. Stripe needs both keys; a failed payment
# keeps the plan for BILLING_GRACE_DAYS. WHMCS customers manage billing in your client area.
BILLING_PROVIDER=free
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=7
WHMCS_CLIENT_AREA_URL=
# A workspace's first brand gets its Chatwoot account by itself (false: Connect by hand only).
CHATWOOT_AUTO_PROVISION=true

# Voice/video (optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
