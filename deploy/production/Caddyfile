# Hamnivo edge: HTTPS for every public name, the static apps and the reverse proxies.
# Names and the certificate setting come from deploy/production/.env (see env.example):
#   HAMNIVO_TLS  an email address: certificates from Let's Encrypt (renewed automatically)
#                "internal": certificates from Caddy's own CA (tests, private networks)
# To change something, copy this file, edit it and mount it over /etc/caddy/Caddyfile.

{
	# Deploys restart the edge. Open live streams then get 3 s to finish (clients reconnect by
	# themselves) instead of holding the restart until Docker kills Caddy after 10 s.
	grace_period 3s
	# Each visitor's address. Directly, it is the connection's own. Behind Cloudflare's proxy
	# (hamnivo.sh setup --cloudflare on), it is the address Cloudflare reports, but only on
	# connections from Cloudflare's ranges (HAMNIVO_TRUSTED_PROXIES), so nobody else can claim one.
	servers {
		trusted_proxies static {$HAMNIVO_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(tls) {
	tls {$HAMNIVO_TLS}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Studio, the staff console: a static app in which every path falls back to index.html. It talks
# only to the API, and no website may frame it.
{$HAMNIVO_APP_HOST} {
	import tls
	import headers
	encode zstd gzip
	root * /srv/studio
	header {
		# {$HAMNIVO_CAPTCHA_ORIGIN}: Cloudflare Turnstile on sign-up, only when its keys are set.
		Content-Security-Policy "default-src 'self'; script-src 'self' {$HAMNIVO_CAPTCHA_ORIGIN}; frame-src 'self' {$HAMNIVO_CAPTCHA_ORIGIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' {$HAMNIVO_API_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@app not path /assets/*
	header @app Cache-Control no-cache
	# Deep links such as /brands load the app; a missing asset stays a 404.
	@deepLink {
		not path /assets/*
		not file
	}
	rewrite @deepLink /index.html
	file_server
}

# Gateway API: REST, staff sign-in, webhooks and live streams (Server-Sent Events are flushed
# as they arrive; responses are not compressed so streams are never buffered).
{$HAMNIVO_API_HOST} {
	import tls
	import headers
	# GitHub push webhooks for automatic deploys (hamnivo.sh autodeploy), only in webhook mode;
	# otherwise this path reaches the API, which answers 404.
	@deployHook {
		method POST
		path /_deploy/github
		expression `"{$HAMNIVO_AUTODEPLOY:off}" == "webhook"`
	}
	handle @deployHook {
		request_body {
			max_size 5MB
		}
		rewrite * /hooks/github
		reverse_proxy deploy-hook:9000 {
			lb_try_duration 5s
		}
	}
	handle {
		# While the API restarts during a deploy, requests wait for it (up to 30 s) instead of
		# failing.
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# Chat widget and its loader. The widget page may only be framed by the brand's allowed websites:
# the gateway names them and they become the page's CSP frame-ancestors. Unknown widgets get 404.
{$HAMNIVO_CHAT_HOST} {
	import tls
	import headers
	encode zstd gzip
	root * /srv/chat

	@page path / /index.html
	route @page {
		request_header -X-Hamnivo-Frame-Ancestors
		forward_auth api:4000 {
			uri /v1/widget/frame-policy?{query}
			copy_headers X-Hamnivo-Frame-Ancestors
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 30s
			lb_try_interval 250ms
		}
		header {
			# blob: shows pictures customers and staff sent, fetched with the session (W09).
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' {$HAMNIVO_API_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors {http.request.header.X-Hamnivo-Frame-Ancestors}"
			Cache-Control no-store
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Customer websites load this script; a short cache lets updates reach them quickly.
	header /loader.js Cache-Control "public, max-age=300"
	file_server
}

# Chatwoot, the conversation authority (its dashboard, APIs and live updates over WebSocket).
{$HAMNIVO_SUPPORT_HOST} {
	import tls
	import headers
	encode zstd gzip
	reverse_proxy chatwoot-web:3000 {
		header_up X-Forwarded-For {client_ip}
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Public website (static, English, Arabic, Hindi and Urdu).
{$HAMNIVO_SITE_HOSTS} {
	import tls
	import headers
	encode zstd gzip

	# Documentation at /docs/. The docs are built with base /docs, so their files sit at the
	# root of /srv/docs and the prefix is stripped before they are looked up.
	redir /docs /docs/ 308
	handle_path /docs/* {
		root * /srv/docs
		@docsAssets path /_astro/*
		header @docsAssets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Website
	root * /srv/site
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# Container health check (port 2020 is not published).
http://:2020 {
	respond /health 200
}

import /etc/caddy/sites/*.caddy
