# Installed by "hamnivo.sh backups on". Every night at about 03:00 in the server's time zone (UTC
# on most servers); a night the server was off is made up at the next start.
[Unit]
Description=Hamnivo backup every night

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=30min
Persistent=true
Unit=hamnivo-backup.service

[Install]
WantedBy=timers.target
