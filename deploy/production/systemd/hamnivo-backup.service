# Installed by "hamnivo.sh backups on" (the @...@ values are filled in then).
# A backup of both databases, Chatwoot's files and the settings; the newest 14 are kept.
[Unit]
Description=Hamnivo nightly backup
Documentation=file://@ROOT@/docs/self-hosting.md
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
Environment=HAMNIVO_ENV_FILE=@ENV_FILE@
Environment=HAMNIVO_PROJECT=@PROJECT@
Environment=HAMNIVO_STATE_DIR=@STATE@
ExecStart=@HAMNIVO@ backup
TimeoutStartSec=6h
# Dumps run in the database containers; this keeps the copying around them polite.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
