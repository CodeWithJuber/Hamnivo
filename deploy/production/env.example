# Reference of the settings in deploy/production/.env. Do not put real values here.
# `hamnivo.sh setup --domain example.com --email you@example.com` writes .env with generated secrets;
# edit .env afterwards and run `hamnivo.sh up` again to apply changes.

# --- Names and certificates --------------------------------------------------------------------
HAMNIVO_DOMAIN=example.com
# An email address: Let's Encrypt certificates. "internal": Caddy's own CA (browsers will warn).
HAMNIVO_TLS=you@example.com
HAMNIVO_APP_HOST=app.example.com
HAMNIVO_API_HOST=api.example.com
HAMNIVO_CHAT_HOST=chat.example.com
HAMNIVO_SUPPORT_HOST=support.example.com
HAMNIVO_SITE_HOSTS="example.com www.example.com"
HAMNIVO_HTTP_PORT=80
HAMNIVO_HTTPS_PORT=443
# Derived from the names above by `hamnivo.sh setup` (re-run it after changing a name).
HAMNIVO_APP_ORIGIN=https://app.example.com
HAMNIVO_API_ORIGIN=https://api.example.com
HAMNIVO_CHAT_ORIGIN=https://chat.example.com
HAMNIVO_SUPPORT_ORIGIN=https://support.example.com
HAMNIVO_SITE_ORIGIN=https://example.com

# --- Generated secrets (never share; back up .env: without it stored secrets cannot be read) -----
HAMNIVO_DB_SUPERUSER_PASSWORD=<generated>
HAMNIVO_DB_OWNER_PASSWORD=<generated>
HAMNIVO_DB_APP_PASSWORD=<generated>
HAMNIVO_DB_PLATFORM_PASSWORD=<generated>
HAMNIVO_VALKEY_PASSWORD=<generated>
HAMNIVO_KEK_BASE64=<generated>
HAMNIVO_KEK_VERSION=1
# Earlier keys, as version:base64 pairs, while secrets are re-encrypted after a key change.
HAMNIVO_KEK_RETIRED=
BETTER_AUTH_SECRET=<generated>
WIDGET_SIGNING_KEY=<generated>
CHATWOOT_SECRET_KEY_BASE=<generated>
CHATWOOT_DB_PASSWORD=<generated>
CHATWOOT_REDIS_PASSWORD=<generated>
CHATWOOT_ADMIN_EMAIL=admin@example.com
CHATWOOT_ADMIN_PASSWORD=<generated>
# Written by `hamnivo.sh up` after it creates the Hamnivo Platform App in Chatwoot.
CHATWOOT_PLATFORM_TOKEN=
# Where Chatwoot sends webhooks: the API's public HTTPS address.
CHATWOOT_WEBHOOK_BASE_URL=https://api.example.com
# Keep false in production: Chatwoot then refuses to call private network addresses.
CHATWOOT_ALLOW_PRIVATE_WEBHOOKS=false

# --- Email ---------------------------------------------------------------------------------------
# Sign-in, verification and invitation emails. Without it they are written to the API log.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Hamnivo <no-reply@example.com>"
REQUIRE_EMAIL_VERIFICATION=true

# --- AI models (optional; agents on the offline hamnivo-mock model need none) ------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Knowledge search: mock (offline, word-based), openai, google or openai-compatible.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hamnivo-embed

# --- Upload scanning ----------------------------------------------------------------------------
# "scan" starts ClamAV (about 2 GB of memory). To run without it, empty both values.
COMPOSE_PROFILES=scan
CLAMAV_URL=tcp://clamav:3310

# --- Operations ----------------------------------------------------------------------------------
LOG_LEVEL=info
# GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>"; disabled when empty.
METRICS_TOKEN=
API_DOCS=true
RATE_LIMIT_PER_MINUTE=600
DATABASE_POOL_MAX=10
# Optional: a brand's widget ID (wid_…) shows a live chat on the website; rebuild with `hamnivo.sh up`.
HAMNIVO_DEMO_WIDGET_ID=
