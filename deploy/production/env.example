# Reference of the settings in deploy/production/.env. Do not put real values here.
# `hamnivo.sh setup --domain example.com --email you@example.com` writes .env with generated secrets;
# edit .env afterwards and run `hamnivo.sh up` again to apply changes.

# --- Names and certificates --------------------------------------------------------------------
HAMNIVO_DOMAIN=example.com
# An email address: Let's Encrypt certificates. "internal": Caddy's own CA (browsers will warn).
HAMNIVO_TLS=you@example.com
HAMNIVO_APP_HOST=app.example.com
HAMNIVO_API_HOST=api.example.com
HAMNIVO_CHAT_HOST=chat.example.com
HAMNIVO_SUPPORT_HOST=support.example.com
HAMNIVO_SITE_HOSTS="example.com www.example.com"
HAMNIVO_HTTP_PORT=80
HAMNIVO_HTTPS_PORT=443
# Derived from the names above by `hamnivo.sh setup` (re-run it after changing a name).
HAMNIVO_APP_ORIGIN=https://app.example.com
HAMNIVO_API_ORIGIN=https://api.example.com
HAMNIVO_CHAT_ORIGIN=https://chat.example.com
HAMNIVO_SUPPORT_ORIGIN=https://support.example.com
HAMNIVO_SITE_ORIGIN=https://example.com

# --- Generated secrets (never share; back up .env: without it stored secrets cannot be read) -----
HAMNIVO_DB_SUPERUSER_PASSWORD=<generated>
HAMNIVO_DB_OWNER_PASSWORD=<generated>
HAMNIVO_DB_APP_PASSWORD=<generated>
HAMNIVO_DB_PLATFORM_PASSWORD=<generated>
HAMNIVO_VALKEY_PASSWORD=<generated>
HAMNIVO_KEK_BASE64=<generated>
HAMNIVO_KEK_VERSION=1
# Earlier keys, as version:base64 pairs, while secrets are re-encrypted after a key change.
HAMNIVO_KEK_RETIRED=
BETTER_AUTH_SECRET=<generated>
WIDGET_SIGNING_KEY=<generated>
CHATWOOT_SECRET_KEY_BASE=<generated>
CHATWOOT_DB_PASSWORD=<generated>
CHATWOOT_REDIS_PASSWORD=<generated>
CHATWOOT_ADMIN_EMAIL=admin@example.com
CHATWOOT_ADMIN_PASSWORD=<generated>
# Written by `hamnivo.sh up` after it creates the Hamnivo Platform App in Chatwoot.
CHATWOOT_PLATFORM_TOKEN=
# Where Chatwoot sends webhooks: the API's public HTTPS address.
CHATWOOT_WEBHOOK_BASE_URL=https://api.example.com
# Keep false in production: Chatwoot then refuses to call private network addresses.
CHATWOOT_ALLOW_PRIVATE_WEBHOOKS=false

# --- Email ---------------------------------------------------------------------------------------
# Sign-in, verification and invitation emails. Without it they are written to the API log.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Hamnivo <no-reply@example.com>"
REQUIRE_EMAIL_VERIFICATION=true

# --- AI models (optional; agents on the offline hamnivo-mock model need none) ------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Knowledge search: mock (offline, word-based), openai, google or openai-compatible.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hamnivo-embed

# --- Shops (optional) ----------------------------------------------------------------------------
# Each brand connects its own Stripe account in Studio; its keys are stored encrypted, never here.
# How long a hosted checkout link stays valid, and how long to wait for the payment provider.
COMMERCE_CHECKOUT_MINUTES=60
COMMERCE_PROVIDER_TIMEOUT_MS=10000

# --- Developer platform, reports and plans (docs/guides/webhooks.md, docs/guides/api-keys.md) ---
# Requests per minute for each API key. Webhooks: attempt deadline, days events (for replays) and
# the delivery log are kept, when a failing endpoint is turned off, sends at the same time.
API_KEY_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_TIMEOUT_MS=15000
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_LOG_DAYS=90
WEBHOOK_DISABLE_AFTER_FAILURES=10
WEBHOOK_DISABLE_AFTER_HOURS=72
WEBHOOK_CONCURRENCY=8
# Origins (comma-separated) every workspace may call over plain HTTP or on a private address, such
# as an internal service. Empty: only public HTTPS hosts. Leave empty unless you need it.
EGRESS_TRUSTED_ORIGINS=
# Reports withhold any number that stands on fewer conversations or responses than this.
ANALYTICS_MIN_GROUP_SIZE=5
# Days from issuing a platform invoice to its due date (docs/self-hosting.md, A7).
BILLING_INVOICE_DUE_DAYS=14

# --- Upload scanning ----------------------------------------------------------------------------
# "scan" starts ClamAV (about 2 GB of memory). To run without it, empty both values.
COMPOSE_PROFILES=scan
CLAMAV_URL=tcp://clamav:3310

# --- Operations ----------------------------------------------------------------------------------
LOG_LEVEL=info
# GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>"; disabled when empty.
METRICS_TOKEN=
API_DOCS=true
RATE_LIMIT_PER_MINUTE=600
DATABASE_POOL_MAX=10
# Optional: a brand's widget ID (wid_…) shows a live chat on the website; rebuild with `hamnivo.sh up`.
HAMNIVO_DEMO_WIDGET_ID=
# "on" when Cloudflare proxies the names (setup --cloudflare on). Caddy then believes the visitor
# addresses Cloudflare reports, from Cloudflare's ranges only; `up` keeps the ranges current.
HAMNIVO_CLOUDFLARE=off
# Proxies whose reported visitor addresses are believed, as address ranges separated by spaces
# (written by setup and up when HAMNIVO_CLOUDFLARE is on). Empty: nobody's.
HAMNIVO_TRUSTED_PROXIES=

# --- Deploys (docs/self-hosting.md, A7 and A10) --------------------------------------------------
# The images that run: the commit a deploy started (written by deploys), "local" after `up`.
HAMNIVO_IMAGE_TAG=local
# The branch that deploys, and whether pushes to it deploy by themselves: off, webhook or poll
# (set by `hamnivo.sh autodeploy enable`).
HAMNIVO_DEPLOY_BRANCH=main
HAMNIVO_AUTODEPLOY=off
# Written by `autodeploy enable`: the repository the webhook accepts, its secret, and the user the
# webhook receiver runs as.
HAMNIVO_DEPLOY_REPOSITORY=owner/name
HAMNIVO_DEPLOY_WEBHOOK_SECRET=<generated>
HAMNIVO_DEPLOY_UID=1000
HAMNIVO_DEPLOY_GID=1000
# Optional: a fine-grained token (this repository, "Deployments: Read and write") shows each deploy
# on GitHub under Environments → production.
GITHUB_DEPLOY_TOKEN=
# Packages built and tested at once. Builds run next to the live services: 1 on small servers.
HAMNIVO_BUILD_CONCURRENCY=2
# Images of this many versions are kept for rollbacks; Docker's build cache stays under this size.
HAMNIVO_DEPLOY_KEEP=3
HAMNIVO_DEPLOY_BUILD_CACHE_GB=8
# A deploy needs this much free disk space for Docker.
HAMNIVO_DEPLOY_MIN_FREE_GB=8
# How long a new version may take to become healthy, then how long it must stay healthy (seconds).
HAMNIVO_DEPLOY_HEALTH_SECONDS=600
HAMNIVO_DEPLOY_SOAK_SECONDS=45
# Backups made before deploys that change the database (backups/before-deploy): the newest N stay.
HAMNIVO_DEPLOY_BACKUPS=5
