---
import nastaliq from '@fontsource/noto-nastaliq-urdu/files/noto-nastaliq-urdu-arabic-400-normal.woff2?url';
import notoArabic from '@fontsource/noto-sans-arabic/files/noto-sans-arabic-arabic-400-normal.woff2?url';
import notoArabic600 from '@fontsource/noto-sans-arabic/files/noto-sans-arabic-arabic-600-normal.woff2?url';
import notoDevanagari from '@fontsource/noto-sans-devanagari/files/noto-sans-devanagari-devanagari-400-normal.woff2?url';
import notoDevanagari600 from '@fontsource/noto-sans-devanagari/files/noto-sans-devanagari-devanagari-600-normal.woff2?url';
import dmSansLatinExt from '@fontsource-variable/dm-sans/files/dm-sans-latin-ext-wght-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import { palette } from '@hamnivo/brand';
import { dictionaries, type Locale, localeInfo, localePath, locales } from '../i18n';
import { inkBandCss } from '../lib/theme';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale];
// `site` always comes from astro.config.ts (PUBLIC_SITE_URL or its default).
const absolute = (path: string) => new URL(path, Astro.site).href;
const ogImage = absolute('/og-image.png');

// The fonts never swap in after the first paint, so the page never shifts when one arrives late
// (site.spec.ts:119; Arabic measured 0.05 on a busy CI server). A preloaded `optional` font holds
// the first paint for about 100 ms (Chrome 83+); one that is still late is skipped for this page
// view and the fallback stays. So each language preloads what its first screen shows: body text,
// headings and Latin words such as the product name. Same families and files as the @fontsource
// packages, whose own CSS uses `swap`.
const preloadFonts: Record<Locale, string[]> = {
  en: [dmSansLatin],
  ar: [notoArabic, notoArabic600, dmSansLatin],
  hi: [dmSansLatin, notoDevanagari, notoDevanagari600],
  ur: [nastaliq, dmSansLatin],
};
const dmSansRanges = {
  latin:
    'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD',
  latinExt:
    'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF',
};
const face = (family: string, weight: string, url: string, format: string, range?: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:optional;font-weight:${weight};src:url(${url}) format('${format}');${range ? `unicode-range:${range};` : ''}}`;
const fontFaces = [
  face('DM Sans Variable', '100 1000', dmSansLatinExt, 'woff2-variations', dmSansRanges.latinExt),
  face('DM Sans Variable', '100 1000', dmSansLatin, 'woff2-variations', dmSansRanges.latin),
  face('Noto Sans Arabic', '400', notoArabic, 'woff2'),
  face('Noto Sans Arabic', '600', notoArabic600, 'woff2'),
  face('Noto Sans Devanagari', '400', notoDevanagari, 'woff2'),
  face('Noto Sans Devanagari', '600', notoDevanagari600, 'woff2'),
  face('Noto Nastaliq Urdu', '400', nastaliq, 'woff2'),
].join('');
---

<!doctype html>
<html lang={locale} dir={localeInfo[locale].dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <style is:inline set:html={inkBandCss}></style>
    <style is:inline set:html={fontFaces}></style>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={absolute(localePath(locale))} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(localePath(l))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('/')} />
    {preloadFonts[locale].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={palette.ink} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hamnivo" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={absolute(localePath(locale))} />
    <meta property="og:locale" content={localeInfo[locale].ogLocale} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={localeInfo[l].ogLocale} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipLink}</a>
    <slot />
  </body>
</html>
