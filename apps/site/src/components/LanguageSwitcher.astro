---
import { dictionaries, type Locale, localeInfo, localePath, locales } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
---

<nav aria-label={dictionaries[locale].a11y.languageNav} class={className}>
  <ul class="flex flex-wrap items-center gap-1 sm:justify-end">
    {
      locales.map((l) => (
        <li>
          <a
            href={localePath(l)}
            lang={l}
            hreflang={l}
            aria-current={l === locale ? 'page' : undefined}
            class="lang-link"
          >
            {localeInfo[l].name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--hv-radius-md);
    color: var(--ink-text);
    /* One Naskh-style stack for every page, so showing a language name never pulls in Nastaliq. */
    font-family: "DM Sans Variable", "Noto Sans Arabic", "Noto Sans Devanagari", system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5rem;
    text-decoration: none;
  }
  .lang-link:hover {
    background-color: var(--ink-raised);
  }
  .lang-link[aria-current="page"] {
    box-shadow: inset 0 -2px 0 var(--hv-accent);
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }
</style>
