---
import { dictionaries, type Locale } from '../i18n';
import { links } from '../lib/links';
import Visual from './Visual.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale].hero;
---

{/* The hero illustration was composed for a dark background, so the band stays ink. */}
<section class="on-ink" aria-labelledby="hero-title">
  <div
    class="page-container grid items-center gap-10 pt-8 pb-16 sm:pt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-12 lg:pt-14 lg:pb-24"
  >
    <div class="max-w-2xl">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title" class="display mt-4">{t.title}</h1>
      <p class="lead mt-5">{t.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn btn-primary" href={links.repo}>{t.primaryCta}</a>
        <a class="btn btn-secondary" href="#demo">{t.secondaryCta}</a>
      </div>
      <p class="mt-8 max-w-xl text-base text-on-ink-secondary">
        {t.status}
        <a class="site-link" href={links.featureStatus}>{t.statusLink}</a>
      </p>
    </div>
    <div class="mx-auto w-full max-w-160 lg:max-w-none">
      <Visual
        id="hero"
        locale={locale}
        eager
        sizes="(min-width: 76rem) 37rem, (min-width: 64rem) 50vw, (min-width: 42rem) 40rem, calc(100vw - 2rem)"
      />
    </div>
  </div>
</section>
