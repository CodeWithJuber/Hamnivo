---
import { dictionaries, type Locale } from '../i18n';
import { type LiveDemo, loaderSnippet } from '../lib/demo';
import { links } from '../lib/links';
import CodeBlock from './CodeBlock.astro';

interface Props {
  locale: Locale;
  demo: LiveDemo | null;
}

const { locale, demo } = Astro.props;
const t = dictionaries[locale];
---

<section id="demo" aria-labelledby="demo-title" class="py-16 sm:py-20 lg:py-24">
  <div class="page-container">
    <div
      class="grid gap-8 rounded-xl border border-border bg-surface p-6 shadow-sm sm:p-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12"
    >
      <div>
        <p class="eyebrow">{t.demo.eyebrow}</p>
        <h2 id="demo-title" class="heading-2 mt-3">{t.demo.title}</h2>
        {
          demo ? (
            <>
              <p class="lead mt-4">{t.demo.liveBody}</p>
              <button type="button" class="btn btn-primary mt-6" data-open-chat hidden>
                {t.demo.openChat}
              </button>
            </>
          ) : (
            <>
              <p class="lead mt-4">{t.demo.offlineBody}</p>
              <p class="mt-4 text-text-secondary">{t.demo.offlineHint}</p>
            </>
          )
        }
        <p class="mt-6">
          <a class="site-link" href={links.putChatOnPage}>{t.demo.guideLink}</a>
        </p>
      </div>
      <div class="min-w-0">
        {demo && <p class="mb-3 text-text-secondary">{t.demo.liveCode}</p>}
        <CodeBlock id="loader-snippet" code={loaderSnippet(demo)} label={t.code.html} strings={t.code} />
      </div>
    </div>
  </div>
</section>
