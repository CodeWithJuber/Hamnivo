{
  "name": "@hamnivo/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Hamnivo Gateway: public REST API, staff authentication, administration and background worker (NestJS + Fastify)",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env.local --watch-path=dist dist/main.api.js",
    "start:api": "node --env-file-if-exists=../../.env.local dist/main.api.js",
    "start:worker": "node --env-file-if-exists=../../.env.local dist/main.worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.18",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@hamnivo/adapters": "workspace:*",
    "@hamnivo/chatwoot": "workspace:*",
    "@hamnivo/contracts": "workspace:*",
    "@hamnivo/db": "workspace:*",
    "@hamnivo/domain": "workspace:*",
    "@hamnivo/policy": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@node-rs/argon2": "2.2.1",
    "@prometheus-io/client": "0.16.1",
    "@scalar/fastify-api-reference": "1.72.1",
    "ai": "7.0.116",
    "better-auth": "1.7.6",
    "bullmq": "6.3.9",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "html-to-text": "10.0.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "mammoth": "1.13.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "1.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/html-to-text": "9.0.4",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.12.1",
    "eventsource-parser": "4.1.1",
    "oidc-provider": "9.12.2",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
