{
  "name": "@hamnivo/widget",
  "version": "0.1.0",
  "private": true,
  "description": "Hamnivo Chat: the customer chat widget that runs in an iframe on the brand's website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.22",
    "@hamnivo/client": "workspace:*",
    "@hamnivo/contracts": "workspace:*",
    "@hamnivo/domain": "workspace:*",
    "@hamnivo/ui": "workspace:*",
    "dompurify": "3.4.16",
    "i18next": "26.4.2",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@hamnivo/adapters": "workspace:*",
    "@hamnivo/chatwoot": "workspace:*",
    "@hamnivo/db": "workspace:*",
    "@hamnivo/server": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.1",
    "vitest": "catalog:"
  }
}
