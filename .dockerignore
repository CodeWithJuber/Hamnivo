# Keeps the Docker build context small and free of secrets. Images are built from source only.
.git
.githooks
.claude
.turbo
**/.turbo
**/node_modules
**/dist
**/build
**/.astro
**/storybook-static
**/coverage
**/test-results
**/playwright-report
**/blob-report
**/*.tsbuildinfo
**/*.log

# Secrets and local data never enter an image.
.env
.env.*
!.env.example
**/.env
**/.env.*
deploy/production/.env
deploy/production/chatwoot.env
deploy/production/backups
deploy/production/state
**/e2e/.stack.json
**/e2e/.host.html
.data

# Not needed to build: design boards, documentation and the design originals. Two folders stay:
# - docs/evals: packages/evals tests replay a recorded live run from it (decisions.test.ts reads
#   docs/evals/*.answers.json);
# - docs/guide: the docs site (apps/docs) publishes these guides, and the React and Vue packages
#   test that the guide shows the code they type-check.
docs/*
!docs/evals
!docs/guide
